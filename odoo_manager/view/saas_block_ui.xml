<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="saas_block_ui_layout" inherit_id="web.layout">
        <xpath expr="//body" position="inside">
            <t t-set="saas_status" t-value="request.env['ir.config_parameter'].sudo().get_param('saas.subscription_status', 'active')"/>

            <t t-if="saas_status != 'active'">
                <!-- Top Red Banner inspired by Odoo.sh[cite: 1] -->
                <div id="saas_expired_banner"
                     style="
                        position: fixed;
                        top: 0; left: 0;
                        width: 100%;
                        background: #d9534f; /* Odoo.sh Red */
                        color: white;
                        text-align: center;
                        padding: 12px 0;
                        font-size: 15px;
                        font-weight: bold;
                        z-index: 999999;
                        box-shadow: 0 2px 5px rgba(0,0,0,0.3);
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        gap: 20px;
                        font-family: sans-serif;
                     ">
                    <span>⚠️ Your subscription has expired. Please contact support to restore full access.</span>
                    <a href="mailto:support@optimum.com"
                       style="
                        background: white;
                        color: #d9534f;
                        padding: 5px 15px;
                        border-radius: 4px;
                        text-decoration: none;
                        font-size: 12px;
                        text-transform: uppercase;
                       ">Contact Support</a>
                </div>

                <style>
                    /* Push the Odoo Navbar down to accommodate the banner[cite: 1] */
                    .o_navbar, .o_web_client {
                        margin-top: 45px !important;
                    }
                    /* Visual indicator that the system is restricted */
                    .o_action_manager {
                        opacity: 0.85;
                        pointer-events: none !important; /* Disables clicks[cite: 1] */
                    }
                </style>
            </t>
        </xpath>
    </template>
</odoo>