<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="saas_block_ui_layout" inherit_id="web.layout">
        <xpath expr="//body" position="inside">
            <t t-set="saas_status" t-value="request.env['ir.config_parameter'].sudo().get_param('saas.subscription_status', 'active')"/>

            <!-- Display banner and restrictions only if status is not active[cite: 1] -->
            <t t-if="saas_status != 'active' and request.session.uid">

                <!-- Red Support Banner at the very top -->
                <div id="saas_expired_banner"
                     style="
                        position: fixed;
                        top: 0; left: 0;
                        width: 100%;
                        background: #d9534f;
                        color: white;
                        text-align: center;
                        padding: 10px 0;
                        font-size: 14px;
                        font-weight: bold;
                        z-index: 10001;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        gap: 15px;
                     ">
                    <span>⚠️ Subscription Suspended - Full access is restricted</span>
                    <a href="mailto:support@optimum.com" style="color: white; text-decoration: underline;">Contact Support</a>
                </div>

                <style>
                    /* 1. Push Navbar down to sit below our red banner[cite: 1] */
                    .o_navbar {
                        top: 40px !important;
                        pointer-events: auto !important; /* Enable navbar clicks[cite: 1] */
                        z-index: 10000 !important;
                    }

                    /* 2. Disable interaction with the entire app content[cite: 1] */
                    .o_action_manager, .o_content, .o_main_navbar + div {
                        margin-top: 40px !important;
                        pointer-events: none !important; /* Block all clicks in app content[cite: 1] */
                        user-select: none;
                        opacity: 0.7;
                    }

                    /* 3. Explicitly re-enable clicks for the Navbar and its menus[cite: 1] */
                    .o_navbar *, .o_user_menu, .dropdown-menu {
                        pointer-events: auto !important;
                    }

                    /* Adjust body to prevent scroll overlap if necessary[cite: 1] */
                    body {
                        padding-top: 40px !important;
                    }
                </style>
            </t>
        </xpath>
    </template>
</odoo>