<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="saas_block_ui_layout" inherit_id="web.layout">
        <xpath expr="//head" position="inside">
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
        </xpath>

        <xpath expr="//body" position="inside">
            <t t-set="saas_status" t-value="request.env['ir.config_parameter'].sudo().get_param('saas.subscription_status', 'active')"/>

            <t t-if="saas_status != 'active' and request.session.uid">

                <!-- 1. Warning Banner (Odoo Enterprise Blue Style) -->
                <t t-if="saas_status == 'warning'">
                    <div id="saas_warning_banner" style="
                        position: fixed;
                        top: 0;
                        left: 0;
                        width: 100%;
                        background: linear-gradient(90deg, #d6eaf8 0%, #ebf5fb 50%, #d6eaf8 100%);
                        border-bottom: 1px solid #aed6f1;
                        color: #1a5276;
                        text-align: center;
                        padding: 9px 16px;
                        font-size: 13px;
                        font-weight: 500;
                        z-index: 10001;
                        box-shadow: 0 1px 4px rgba(41, 128, 185, 0.12);
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        gap: 12px;
                        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                        letter-spacing: 0.01em;
                    ">
                        <span style="display: flex; align-items: center; gap: 7px;">
                            <i class="bi bi-info-circle-fill" style="font-size: 15px; color: #2980b9;"></i>
                            Your subscription is expiring soon. Please renew to avoid service interruption.
                        </span>
                        <a href="mailto:support@optimum.com" style="
                            color: #1a5276;
                            text-decoration: none;
                            background: #2980b9;
                            color: white;
                            padding: 3px 12px;
                            border-radius: 4px;
                            font-size: 12px;
                            font-weight: 600;
                            letter-spacing: 0.02em;
                            transition: background 0.2s;
                        ">Renew Now</a>
                    </div>
                    <style>
                        #saas_warning_banner a:hover { background: #1f618d !important; }
                        .o_navbar { top: 40px !important; }
                        .o_action_manager, .o_content { margin-top: 40px !important; }
                    </style>
                </t>

                <!-- 2. Stopped Banner (Red) + UI Block -->
                <t t-if="saas_status == 'stopped'">
                    <div id="saas_stopped_banner" style="
                        position: fixed;
                        top: 0;
                        left: 0;
                        width: 100%;
                        background: linear-gradient(90deg, #fdedec 0%, #fef9f9 50%, #fdedec 100%);
                        border-bottom: 1px solid #f1948a;
                        color: #922b21;
                        text-align: center;
                        padding: 9px 16px;
                        font-size: 13px;
                        font-weight: 500;
                        z-index: 10001;
                        box-shadow: 0 1px 4px rgba(192, 57, 43, 0.12);
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        gap: 12px;
                        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                        letter-spacing: 0.01em;
                    ">
                        <span style="display: flex; align-items: center; gap: 7px;">
                            <i class="bi bi-exclamation-triangle-fill" style="font-size: 15px; color: #c0392b;"></i>
                            Subscription Suspended. Access is restricted. Read-only mode is active.
                        </span>
                        <a href="mailto:support@optimum.com" style="
                            color: white;
                            text-decoration: none;
                            background: #c0392b;
                            padding: 3px 12px;
                            border-radius: 4px;
                            font-size: 12px;
                            font-weight: 600;
                            letter-spacing: 0.02em;
                        ">Contact Support</a>
                    </div>

                    <style>
                        #saas_stopped_banner a:hover { background: #a93226 !important; }

                        /* Banner spacing */
                        .o_navbar {
                            top: 40px !important;
                            z-index: 10000 !important;
                            pointer-events: auto !important;
                        }

                        /* Keep navbar fully interactive */
                        .o_navbar *,
                        .o_menu_brand,
                        .o_user_menu,
                        .o_main_navbar,
                        .dropdown,
                        .dropdown-menu,
                        .dropdown-item,
                        .o_user_menu .dropdown-toggle,
                        a[data-action="logout"],
                        .o_logout {
                            pointer-events: auto !important;
                            opacity: 1 !important;
                            filter: none !important;
                        }

                        /* Block everything below the navbar */
                        .o_action_manager,
                        .o_content,
                        .o_main_content,
                        .o_view_controller {
                            margin-top: 40px !important;
                            pointer-events: none !important;
                            user-select: none !important;
                            opacity: 0.55;
                            filter: grayscale(40%);
                            transition: opacity 0.3s ease;
                        }

                        /* Overlay to reinforce the block visually */
                        .o_action_manager::after {
                            content: '';
                            position: fixed;
                            top: 80px;
                            left: 0;
                            width: 100%;
                            height: 100%;
                            background: rgba(255, 255, 255, 0.25);
                            z-index: 9000;
                            pointer-events: none;
                        }
                    </style>
                </t>

            </t>
        </xpath>
    </template>
</odoo>